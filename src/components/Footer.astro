        </div>

        <!-- Copyright -->
        <div class="font-body font-normal text-[15px] leading-[140%] text-center" style="color: rgba(147, 147, 147, 1);">
          © Cleric 2025
        </div>

      </div>
    </div>

    <!-- Tablet & Desktop Layout (>= 768px) -->
    <div class="hidden md:block">
      <div class="max-w-7xl mx-auto">

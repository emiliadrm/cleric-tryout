              </li>
              <li>
                <a href="#deployment-failures" class="font-body font-normal text-[15px] leading-[140%] transition-colors" style="color: rgba(0, 0, 0, 1);" onmouseover="this.style.color='rgba(107, 107, 107, 1)'" onmouseout="this.style.color='rgba(0, 0, 0, 1)'">

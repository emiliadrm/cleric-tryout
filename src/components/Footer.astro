          <div>
            <h3 class="font-body font-semibold text-[15px] leading-[140%] mb-6" style="color: rgba(0, 0, 0, 1);">Cleric</h3>
            <ul class="space-y-2">
              <li>
                <a href="#about" class="font-body font-normal text-[15px] leading-[140%] transition-colors" style="color: rgba(0, 0, 0, 1);" onmouseover="this.style.color='rgba(107, 107, 107, 1)'" onmouseout="this.style.color='rgba(0, 0, 0, 1)'">

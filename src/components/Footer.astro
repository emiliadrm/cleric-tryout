---
export interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;
---

<footer class={`bg-cleric-white py-12 ${className}`}>
  <div class="container mx-auto px-4 md:px-10 2xl:px-20">

    <!-- Mobile Layout (< 768px) -->
    <div class="md:hidden">
      <!-- Logo -->
      <div class="mb-8">
        <img src="/images/logo-vector.svg" alt="Cleric AI" class="h-8 w-auto" />
      </div>

      <!-- Row 1: Cleric + Help & Security -->
      <div class="grid grid-cols-2 gap-8 mb-8">

        <!-- Column 1: Cleric -->
        <div>
          <h3 class="font-body font-semibold text-[15px] leading-[140%] mb-6" style="color: rgba(0, 0, 0, 1);">Cleric</h3>
          <ul class="space-y-2">
            <li>
              <a href="#about" class="font-body font-normal text-[15px] leading-[140%] transition-colors" style="color: rgba(0, 0, 0, 1);" onmouseover="this.style.color='rgba(107, 107, 107, 1)'" onmouseout="this.style.color='rgba(0, 0, 0, 1)'">
                About
              </a>
            </li>
            <li>
              <a href="#careers" class="font-body font-normal text-[15px] leading-[140%] transition-colors" style="color: rgba(0, 0, 0, 1);" onmouseover="this.style.color='rgba(107, 107, 107, 1)'" onmouseout="this.style.color='rgba(0, 0, 0, 1)'">
                Careers
              </a>
            </li>
            <li>
              <a href="#product" class="font-body font-normal text-[15px] leading-[140%] transition-colors" style="color: rgba(0, 0, 0, 1);" onmouseover="this.style.color='rgba(107, 107, 107, 1)'" onmouseout="this.style.color='rgba(0, 0, 0, 1)'">
                Product
              </a>
            </li>
            <li>
              <a href="#blog" class="font-body font-normal text-[15px] leading-[140%] transition-colors" style="color: rgba(0, 0, 0, 1);" onmouseover="this.style.color='rgba(107, 107, 107, 1)'" onmouseout="this.style.color='rgba(0, 0, 0, 1)'">
                Blog
              </a>
            </li>
            <li>
              <a href="#webinars" class="font-body font-normal text-[15px] leading-[140%] transition-colors" style="color: rgba(0, 0, 0, 1);" onmouseover="this.style.color='rgba(107, 107, 107, 1)'" onmouseout="this.style.color='rgba(0, 0, 0, 1)'">
                Webinars
              </a>
            </li>
          </ul>
        </div>

        <!-- Column 2: Help & Security -->
        <div>
          <h3 class="font-body font-semibold text-[15px] leading-[140%] mb-6" style="color: rgba(0, 0, 0, 1);">Help & Security</h3>
          <ul class="space-y-2">
            <li>
              <a href="#trust-center" class="font-body font-normal text-[15px] leading-[140%] transition-colors" style="color: rgba(0, 0, 0, 1);" onmouseover="this.style.color='rgba(107, 107, 107, 1)'" onmouseout="this.style.color='rgba(0, 0, 0, 1)'">
                Trust Center
              </a>
            </li>
            <li>
              <a href="#terms" class="font-body font-normal text-[15px] leading-[140%] transition-colors" style="color: rgba(0, 0, 0, 1);" onmouseover="this.style.color='rgba(107, 107, 107, 1)'" onmouseout="this.style.color='rgba(0, 0, 0, 1)'">
                Terms of Use
              </a>
            </li>
            <li>
              <a href="#privacy" class="font-body font-normal text-[15px] leading-[140%] transition-colors" style="color: rgba(0, 0, 0, 1);" onmouseover="this.style.color='rgba(107, 107, 107, 1)'" onmouseout="this.style.color='rgba(0, 0, 0, 1)'">
                Privacy Policy
              </a>
            </li>
          </ul>
        </div>

      </div>

      <!-- Row 2: Use Cases -->
      <div class="mb-8">
        <h3 class="font-body font-semibold text-[15px] leading-[140%] mb-6" style="color: rgba(0, 0, 0, 1);">Use Cases</h3>
        <div class="grid grid-cols-2 gap-8">

          <!-- Column 1 -->
          <ul class="space-y-2">
            <li>
              <a href="#alert-investigation" class="font-body font-normal text-[15px] leading-[140%] transition-colors" style="color: rgba(0, 0, 0, 1);" onmouseover="this.style.color='rgba(107, 107, 107, 1)'" onmouseout="this.style.color='rgba(0, 0, 0, 1)'">
                Alert Investigation
              </a>
            </li>
            <li>
              <a href="#root-cause" class="font-body font-normal text-[15px] leading-[140%] transition-colors" style="color: rgba(0, 0, 0, 1);" onmouseover="this.style.color='rgba(107, 107, 107, 1)'" onmouseout="this.style.color='rgba(0, 0, 0, 1)'">
                Root Cause Analysis
              </a>
            </li>
            <li>
              <a href="#fix-recommendation" class="font-body font-normal text-[15px] leading-[140%] transition-colors" style="color: rgba(0, 0, 0, 1);" onmouseover="this.style.color='rgba(107, 107, 107, 1)'" onmouseout="this.style.color='rgba(0, 0, 0, 1)'">
                Fix Recommendation
              </a>
            </li>
          </ul>

          <!-- Column 2 -->
          <ul class="space-y-2">
            <li>
              <a href="#on-call" class="font-body font-normal text-[15px] leading-[140%] transition-colors" style="color: rgba(0, 0, 0, 1);" onmouseover="this.style.color='rgba(107, 107, 107, 1)'" onmouseout="this.style.color='rgba(0, 0, 0, 1)'">
                On-Call Automation
              </a>
            </li>
            <li>
              <a href="#incident-triage" class="font-body font-normal text-[15px] leading-[140%] transition-colors" style="color: rgba(0, 0, 0, 1);" onmouseover="this.style.color='rgba(107, 107, 107, 1)'" onmouseout="this.style.color='rgba(0, 0, 0, 1)'">
                Incident Triage
              </a>
            </li>
            <li>
              <a href="#deployment-failures" class="font-body font-normal text-[15px] leading-[140%] transition-colors" style="color: rgba(0, 0, 0, 1);" onmouseover="this.style.color='rgba(107, 107, 107, 1)'" onmouseout="this.style.color='rgba(0, 0, 0, 1)'">
                Deployment Failures
              </a>
            </li>
          </ul>

        </div>
      </div>

      <!-- Bottom Section: Social Icons + Copyright (Centered) -->
      <div class="flex flex-col items-center gap-4">

        <!-- Social Icons -->
        <div class="flex items-center justify-center gap-4">
          <a href="https://linkedin.com" target="_blank" rel="noopener noreferrer" class="text-text-b hover:text-text-a transition-colors" aria-label="LinkedIn">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg">
              <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/>
            </svg>
          </a>
          <a href="https://twitter.com" target="_blank" rel="noopener noreferrer" class="text-text-b hover:text-text-a transition-colors" aria-label="Twitter">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg">
              <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
            </svg>

---
import AnnouncementBanner from '../components/AnnouncementBanner.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import Button from '../components/ui/Button.astro';
import HeroBadgeLink from '../components/ui/HeroBadgeLink.astro';
import '../global.css';
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Cleric AI - Transform Your Workflow</title>
  <meta name="description" content="AI-powered solutions for modern businesses">
</head>
<body class="min-h-screen">

  <!-- Announcement Banner -->
  <AnnouncementBanner 
    text="Cleric Named a Gartner® Cool Vendor 2025 in AI for SRE and Observability."
    linkUrl="#learn-more"
    linkText="Find out more"
  />

  <!-- Navbar -->
  <Navbar />

  <!-- Hero Section with Background -->
  <section class="relative min-h-screen overflow-hidden">

    <!-- Background Image -->
    <div class="absolute inset-0 z-0">
      <img
        src="/images/background.jpg"
        alt="Background"
        class="absolute bottom-[-15%] left-0 right-0 w-full h-[115%] md:bottom-[-20%] md:h-[130%] lg:bottom-[-25%] lg:h-[155%] object-cover object-[center_top]"
      />
      <!-- White gradient fade at bottom for transition -->
      <div class="absolute bottom-0 left-0 right-0 h-24 md:h-48 bg-gradient-to-t from-cleric-white via-cleric-white/80 to-transparent z-10"></div>
    </div>

    <!-- Content -->
    <div class="relative z-10 container mx-auto px-4 lg:px-8 text-center pt-24 md:pt-32 lg:pt-40 pb-12">
      <div class="max-w-4xl mx-auto space-y-6 md:space-y-8">

        <!-- Hero Badge Link -->
        <HeroBadgeLink
          badgeText="Press release"
          mainText="Cleric launches the first self-learning AI SRE"
        />

        <!-- Title -->
        <h1 class="text-5xl md:text-6xl lg:text-7xl font-heading text-cleric-white leading-tight">
          The AI SRE that learns from your engineers
        </h1>

        <!-- Subtitle -->
        <p class="text-base md:text-lg lg:text-xl text-cleric-white font-body font-normal max-w-2xl mx-auto">
          Cleric investigates production issues, captures what works, and makes your whole team faster.
        </p>

        <!-- CTA Buttons -->
        <div class="flex flex-row items-center justify-center gap-4 pt-4">
          <Button type="primary" size="medium" mode="light">
            Start for Free
          </Button>
          <Button type="secondary" size="medium" mode="light">
            Request Demo
          </Button>
        </div>

      </div>
    </div>

    <!-- Hero Slack Images -->
    <div class="relative z-10 container mx-auto px-4 lg:px-8 mt-8 md:mt-12 mt-4">
      <!-- Desktop: Both images with normal on bottom right -->
      <div class="hidden md:block relative md:max-w-2xl lg:max-w-4xl xl:max-w-5xl mx-auto">
        <img
          src="/images/hero_slack-dt.png"
          alt="Cleric AI Slack Integration"
          class="w-full h-auto drop-shadow-2xl"
        />
        <img
          src="/images/hero_slack.png"
          alt="Cleric AI Slack Details"
          class="absolute bottom-0 xl:-right-[8%] xl:w-[30%] h-auto drop-shadow-2xl md:w-[28%] md:-right-[5%]"
        />
      </div>

      <!-- Mobile: Single centered image -->
      <div class="md:hidden max-w-md mx-auto">
        <img
          src="/images/hero_slack-mobile.png"
          alt="Cleric AI Slack Integration"
          class="w-full h-auto drop-shadow-xl"
        />
      </div>
    </div>

    <!-- White gradient fade at bottom -->
    <div class="absolute bottom-0 left-0 right-0 h-32 bg-gradient-to-t from-cleric-white to-transparent z-10"></div>

  </section>

  <!-- Stats Section -->
  <section class="py-16 md:py-20 bg-cleric-white">
    <div class="container mx-auto px-4 lg:px-8">
      <!-- Mobile: Column (< 768px) -->
      <!-- Tablet: Wrap with 2 on top, 1 on bottom (768px - 1023px) -->
      <!-- Desktop: Single row with justify-center (>= 1024px) -->
      <div class="flex flex-col md:flex-row md:flex-wrap lg:flex-nowrap justify-center items-center gap-12 lg:gap-6 max-w-[1192px] mx-auto">

        <!-- Stat 1 -->
        <div class="text-center w-[20rem] flex-shrink-0">
          <div class="font-body font-semibold text-[32px] md:text-[40px] lg:text-[44px] leading-[115%] tracking-[-0.005em] text-text-a mb-2">
            5 min
          </div>
          <div class="font-body font-normal text-base md:text-lg leading-[140%] text-text-b">
            Time to Root Cause
          </div>
        </div>

        <!-- Stat 2 -->
        <div class="text-center w-[20rem] flex-shrink-0">
          <div class=" font-body font-semibold text-[32px] md:text-[40px] lg:text-[44px] leading-[115%] tracking-[-0.005em] text-text-a mb-2">
            92%
          </div>
          <div class="font-body font-normal text-base md:text-lg leading-[140%] text-text-b">
            Actionable Findings
          </div>
        </div>

        <!-- Stat 3 -->
        <div class="text-center w-[20rem] flex-shrink-0 md:w-full lg:w-auto">
          <div class="font-body font-semibold text-[32px] md:text-[40px] lg:text-[44px] leading-[115%] tracking-[-0.005em] text-text-a mb-2">
            200,000+
          </div>
          <div class="font-body font-normal text-base md:text-lg leading-[140%] text-text-b">
            Production-Grade Investigations
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- Footer -->
  <Footer />

</body>
</html>

---
import Layout from '../layouts/Layout.astro';
import AnnouncementBanner from '../components/AnnouncementBanner.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import Button from '../components/ui/Button.astro';
import HeroBadgeLink from '../components/ui/HeroBadgeLink.astro';
import LogoBrand from '../components/ui/LogoBrand.astro';
import UnblockSection from '../components/UnblockSection.astro';
import FeatureCard from '../components/FeatureCard.astro';
import Eyebrow from '../components/ui/Eyebrow.astro';
import SecuritySection from '../components/SecuritySection.astro';
---

<Layout
  title="Cleric AI - The AI SRE that learns from your engineers"
  description="Cleric investigates production issues, captures what works, and makes your whole team faster. AI-powered solutions for modern businesses."
>

  <!-- Announcement Banner -->
  <AnnouncementBanner 
    text="Cleric Named a Gartner® Cool Vendor 2025 in AI for SRE and Observability."
    linkUrl="#learn-more"
    linkText="Find out more"
  />

  <!-- Navbar -->
  <Navbar />

  <!-- Hero Section with Background -->
  <main id="main-content" class="flex-1">
  <section class="relative overflow-hidden" aria-label="Hero section">

    <!-- Background Image -->
    <div class="absolute inset-0 z-0">
      <img
        src="/images/background.jpg"
        alt="Hero background showing AI SRE interface"
        class="absolute bottom-[-15%] left-0 right-0 w-full h-[115%] md:bottom-[-20%] md:h-[130%] lg:bottom-[-25%] lg:h-[155%] object-cover object-[center_top]"
        loading="eager"
        fetchpriority="high"
      />
      <!-- White gradient fade at bottom for transition -->
      <div class="absolute bottom-0 left-0 right-0 h-24 md:h-48 bg-gradient-to-t from-cleric-white via-cleric-white/80 to-transparent z-10"></div>
    </div>

    <!-- Content -->
    <div class="relative z-20 container mx-auto px-4 lg:px-8 text-center pt-24 md:pt-32 lg:pt-40 pb-12">
      <div class="max-w-4xl mx-auto space-y-6 md:space-y-8">

        <!-- Hero Badge Link -->
        <HeroBadgeLink
          badgeText="Press release"
          mainText="Cleric launches the first self-learning AI SRE"
        />

        <!-- Title -->
        <h1 class="text-5xl md:text-6xl lg:text-7xl font-heading text-cleric-white leading-tight">
          The AI SRE that learns from your engineers
        </h1>

        <!-- Subtitle -->
        <p class="text-base md:text-lg lg:text-xl text-cleric-white font-body font-normal max-w-2xl mx-auto">
          Cleric investigates production issues, captures what works, and makes your whole team faster.
        </p>

        <!-- CTA Buttons -->
        <div class="flex flex-row items-center justify-center gap-4 pt-4">
          <Button type="primary" size="medium" mode="light" as="a" href="#start-free">
            Start for Free
          </Button>
          <Button type="secondary" size="medium" mode="light" as="a" href="#request-demo">
            Request Demo
          </Button>
        </div>

      </div>
    </div>

    <!-- Hero Slack Images -->
    <div class="relative z-20 container mx-auto px-4 lg:px-8 mt-8 md:mt-12 mb-[1px] md:mb-0 lg:mb-[1px] xl:mb-0">
      <!-- Desktop: Both images with normal on bottom right -->
      <div class="hidden md:block relative md:max-w-2xl lg:max-w-4xl xl:max-w-5xl mx-auto">
        <img
          src="/images/hero_slack-dt.png"
          alt="Cleric AI Slack Integration showing automated investigation"
          class="w-full h-auto drop-shadow-2xl"
          loading="lazy"
          decoding="async"
        />
        <img
          src="/images/hero_slack.png"
          alt="Cleric AI Slack detailed response with root cause analysis"
          class="absolute bottom-0 xl:-right-[8%] xl:w-[30%] h-auto drop-shadow-2xl md:w-[28%] md:-right-[5%]"
          loading="lazy"
          decoding="async"
        />
      </div>

      <!-- Mobile: Single centered image -->
      <div class="md:hidden max-w-md mx-auto">
        <img
          src="/images/hero_slack-mobile.png"
          alt="Cleric AI Slack Integration mobile view"
          class="w-full h-auto drop-shadow-xl"
          loading="lazy"
          decoding="async"
        />
      </div>
    </div>

    <!-- White gradient fade at bottom -->
    <div class="absolute bottom-0 left-0 right-0 h-64 bg-gradient-to-t from-cleric-white via-cleric-white/70 to-transparent z-30"></div>

  </section>

  <!-- Stats Section -->
  <section class="py-16 md:py-20 bg-cleric-white" aria-label="Company statistics">
    <div class="container mx-auto px-4 lg:px-8">
      <!-- Mobile: Column (< 768px) -->
      <!-- Tablet: Wrap with 2 on top, 1 on bottom (768px - 1023px) -->
      <!-- Desktop: Single row with justify-center (>= 1024px) -->
      <div class="flex flex-col md:flex-row md:flex-wrap lg:flex-nowrap justify-center items-center gap-12 lg:gap-6 max-w-[1192px] mx-auto">

        <!-- Stat 1 -->
        <div class="text-center w-[20rem] flex-shrink-0">
          <div class="font-body font-semibold text-[32px] md:text-[40px] lg:text-[44px] leading-[115%] tracking-[-0.005em] text-text-a mb-2">
            5 min
          </div>
          <div class="font-body font-normal text-base md:text-lg leading-[140%] text-text-b">
            Time to Root Cause
          </div>
        </div>

        <!-- Stat 2 -->
        <div class="text-center w-[20rem] flex-shrink-0">
          <div class=" font-body font-semibold text-[32px] md:text-[40px] lg:text-[44px] leading-[115%] tracking-[-0.005em] text-text-a mb-2">
            92%
          </div>
          <div class="font-body font-normal text-base md:text-lg leading-[140%] text-text-b">
            Actionable Findings
          </div>
        </div>

        <!-- Stat 3 -->
        <div class="text-center w-[20rem] flex-shrink-0 md:w-full lg:w-auto">
          <div class="font-body font-semibold text-[32px] md:text-[40px] lg:text-[44px] leading-[115%] tracking-[-0.005em] text-text-a mb-2">
            200,000+
          </div>
          <div class="font-body font-normal text-base md:text-lg leading-[140%] text-text-b">
            Production-Grade Investigations
          </div>
        </div>

      </div>
    </div>
  </section>
   
   
  <!-- BlaBlaCar Section -->
  <section class="mx-4 mb-[140px] md:mb-[80px] xl:mb-[120px] md:mx-auto md:max-w-[642px] lg:max-w-[900px] xl:max-w-[1192px] bg-gradient-to-t from-gray-light to-gray-lighter border rounded-2xl border-gray-medium overflow-hidden">
    <div class="flex flex-col lg:flex-row">
      <!-- Desktop Image (left side) -->
      <div class="hidden xl:block lg:flex-shrink-0 lg:w-64 xl:w-80 overflow-hidden">
        <img
          class="w-full h-full object-cover object-top scale-125"
          src="/assets/avatar-maxime.png"
          alt="Maxime Fouilleul"
        />
      </div>

      <!-- Content -->
      <div class="flex flex-col justify-center p-6 md:p-8 lg:p-10">
        <!-- BlaBlaCar label (mobile/tablet: first, desktop: after quote) -->
        <p class="font-body font-semibold text-[30px] leading-[140%] tracking-[-0.0025em] text-text-a mb-4 order-1 lg:order-2">
          BlaBlaCar
        </p>

        <!-- Quote (mobile/tablet: second, desktop: first) -->
        <blockquote class="mb-6 order-2 lg:order-1">
          <p class="font-body font-normal text-[30px] leading-[140%] tracking-[-0.0025em] text-text-a">
            "I see Cleric functioning as an SRE companion for our Software Engineers. If one team has already solved an alert, we can apply that knowledge elsewhere."
          </p>
        </blockquote>

        <!-- Author info and button -->
        <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4 order-3">
          <div class="flex items-center gap-4">
            <!-- Mobile/Tablet Avatar -->
            <div class="w-16 h-16 rounded-full overflow-hidden xl:hidden flex-shrink-0">
              <img
                class="w-full h-full object-cover scale-150 object-top"
                src="/assets/avatar-maxime.png"
                alt="Maxime Fouilleul"
              />
            </div>
            <div class="flex flex-col">
              <span class="font-body font-semibold text-lg leading-[140%] text-text-a">Maxime Fouilleul</span>
              <span class="font-body font-normal text-lg leading-[140%] text-text-b">Head of Infrastructure & Operations | BlaBlaCar</span>
            </div>
          </div>
          <Button type="primary" size="medium" mode="dark" as="a" href="#read-more">
            Read case study
          </Button>
        </div>
      </div>
    </div>
  </section>

  <!-- Meet Cleric Section -->
  <section class="py-16 md:py-20 lg:py-[120px] bg-gradient-to-b from-gray-light to-gray-lighter">
    <div class="text-center">
      <!-- Eyebrow -->
      <Eyebrow text="How it works" />

      <!-- Title -->
      <h2 class="font-heading font-normal text-[36px] md:text-[44px] lg:text-[48px] leading-[115%] tracking-[-0.005em] text-text-a mt-4 md:mt-5 lg:mt-6">
        Meet Cleric
      </h2>

      <!-- Subtitle -->
      <p class="font-body font-normal text-[18px] md:text-[20px] lg:text-[24px] leading-[125%] tracking-[0.0075em] text-text-b mt-2">
        Cleric investigates problems, surfaces answers, and learns from your engineers.
      </p>

      <!-- Image -->
      <div class="mt-10 md:mt-12 lg:mt-16 px-0 md:px-10 lg:px-[80px]">
        <!-- Desktop image -->
        <img
          src="/assets/meet-cleric.png"
          alt="Meet Cleric - AI SRE Interface"
          class="hidden lg:block w-full h-auto"
          loading="lazy"
          decoding="async"
        />
        <!-- Mobile/Tablet image -->
        <img
          src="/assets/meet-cleric-section.png"
          alt="Meet Cleric - AI SRE Interface"
          class="lg:hidden w-full h-auto px-4"
          loading="lazy"
          decoding="async"
        />
      </div>
    </div>
  </section>



<!-- Cleric in Action Section -->
<section class="pt-20 pb-10 md:pt-[120px] md:pb-[60px] lg:pt-[160px] lg:pb-[80px] px-4">
  <div class="max-w-[1192px] mx-auto">
    <!-- Header -->
    <div class="text-left lg:text-center max-w-2xl md:max-w-[642px] lg:max-w-none mx-auto md:px-0 px-4">
      <Eyebrow text="Cleric in action" />

      <!-- Title -->
      <h2 class="font-heading font-normal text-[32px] md:text-[44px] lg:text-[48px] leading-[115%] tracking-[-0.005em] text-text-a mt-4 md:mt-5 lg:mt-6">
        Things break. Cleric investigates.
      </h2>

      <!-- Subtitle -->
      <p class="font-body font-normal text-[18px] md:text-[20px] lg:text-[24px] leading-[125%] tracking-[0.0075em] text-text-b mt-2">
        While you're still reading the alert, Cleric's already three steps into the investigation.
      </p>
    </div>

    <!-- Feature Cards Container -->
    <div class="mt-10 md:mt-12 lg:mt-16 flex flex-col gap-6 md:gap-8 lg:gap-12">
      <!-- Feature Card: Skip straight to the answer -->
      <FeatureCard
        title="Skip straight to the answer"
        subtitle="Cleric automatically investigates alerts and delivers root cause analysis so you know exactly what's wrong and whether to act."
        image="/assets/skip-straight-to-answer-section.png"
        imageAlt="Skip straight to the answer feature"
        variant="text-left"
        imageBlur="bottom"
      />

      <!-- Feature Card: Trust but verify -->
      <FeatureCard
        title="Trust but verify"
        subtitle="See exactly how Cleric reached its conclusions so you can trust the diagnosis and move to resolution."
        image="/assets/trust-but-verify-section.png"
        imageAlt="Trust but verify feature"
        variant="text-right"
        imageBlur="left"
      />

      <!-- Feature Card: Ship a fix -->
      <FeatureCard
        title="Ship a fix"
        subtitle="Work with Cleric to ship fixes by asking questions, giving instructions, and collaborating until the issue is resolved."
        image="/assets/ship-a-fix-section.png"
        imageAlt="Ship a fix feature"
        variant="text-left"
        imageBlur="right"
        worksInside="slack"
      />

      <!-- Feature Card: Learns from failure -->
      <FeatureCard
        title="Learns from failure"
        subtitle="Engineers leave, context doesn't. Every resolution becomes institutional knowledge your whole team can use."
        image="/assets/learns-from-failure.png"
        imageAlt="Learns from failure feature"
        variant="text-right"
        imageBlur="left"
      />
    </div>
  </div>
</section>

<!-- Foundations Section -->
<section class="mt-10 md:mt-[60px] lg:mt-20 px-4">
  <div class="max-w-[1192px] mx-auto">
    <!-- Header -->
    <div class="text-center lg:text-center md:text-left">
      <Eyebrow text="Foundations" />

      <!-- Title -->
      <h2 class="font-heading font-normal text-[32px] md:text-[44px] lg:text-[48px] leading-[115%] tracking-[-0.005em] text-text-a mt-4 md:mt-5 lg:mt-6">
        Simple on the surface. Serious underneath.
      </h2>

      <!-- Subtitle -->
      <p class="font-body font-normal text-[18px] md:text-[20px] lg:text-[24px] leading-[125%] tracking-[0.0075em] text-text-b mt-2">
        Three purpose-built systems that turn alerts into answers—and make every investigation faster than the last.
      </p>
    </div>

    <!-- Feature Cards Grid -->
    <div class="mt-10 md:mt-12 lg:mt-16">
      <!-- Top Row: 2 cards side by side on desktop -->
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 md:gap-8 lg:gap-12">
        <!-- Maps your world -->
        <FeatureCard
          title="Maps your world"
          subtitle="Services, dependencies, and ownership mapped automatically. When something breaks, Cleric knows where to look."
          image="/assets/maps-your-world.png"
          imageAlt="Maps your world feature"
          variant="column"
          imageStyle="padded"
        />

        <!-- Tests every theory -->
        <FeatureCard
          title="Tests every theory"
          subtitle="Correlates signals, tests hypotheses in parallel, tracks confidence. Systematic elimination, not guesswork."
          image="/assets/test-every-theory-section.png"
          imageAlt="Tests every theory feature"
          variant="column"
          imageStyle="blur-sides-bottom"
        />
      </div>

      <!-- Bottom Row: Full width card -->
      <div class="mt-6 md:mt-8 lg:mt-12">
        <FeatureCard
          title="Compounds over time"
          subtitle="Every fix teaches Cleric something new. Patterns and context accumulate automatically."
          image="/assets/compounds-over-time-section.png"
          imageMobile="/assets/compounds-over-time-section-mobile.png"
          imageAlt="Compounds over time feature"
          variant="column"
          imageBlur="none"
        />
      </div>
    </div>

    <!-- CTA Button -->
    <div class="flex justify-center mt-10 md:mt-12 lg:mt-16 mb-20 md:mb-[120px] lg:mb-[160px]">
      <Button type="primary" size="medium" mode="dark" as="a" href="#explore-platform">
        Explore Full Platform
      </Button>
    </div>
  </div>
</section>

<!-- Security Section -->
<SecuritySection />

<!-- Integrations Section -->
<section class="pt-20 md:pt-[120px] lg:pt-[160px] pb-16 md:pb-20 lg:pb-24 px-4 text-center">

  <Eyebrow text="Integrations" />
  <h2 class="font-heading text-[32px] md:text-[40px] lg:text-[48px] leading-[115%] tracking-[-0.005em] text-text-a my-4">
    Built to plug right into your stack
  </h2>
  <p class="font-body font-normal text-base md:text-lg leading-[140%] text-text-b mb-12">
    Connect your whole stack in an afternoon. Read access by default, write access when you're ready.
  </p>

  <!-- Logo Grid -->
  <div class="logos-grid">
    <!-- Row 1: 8 logos -->
    <LogoBrand name="kubernetes" />
    <LogoBrand name="notion" />
    <LogoBrand name="amazonecs" />
    <LogoBrand name="pulumi" />
    <LogoBrand name="terraform" />
    <LogoBrand name="elastic" />
    <LogoBrand name="n" />
    <LogoBrand name="github" />
    <!-- Row 2: 7 logos -->
    <LogoBrand name="gitlab" />
    <LogoBrand name="grafana" />
    <LogoBrand name="prometheus" />
    <LogoBrand name="azure" />
    <LogoBrand name="confluence" />
    <LogoBrand name="datadog" />
    <LogoBrand name="googlecloud" />
  </div>
</section>

<!-- Unblock Section -->
<UnblockSection />

  </main>



  <!-- Footer -->
  <Footer />

</Layout>
